PowerSave 1
PowerSave_WFI 1

startDriver CHT83XX
CHT_Calibrate -2 0

// Stel batterijen in

// SetPinRole BAT_Relay_n 6

// SetPinRole BAT_ADC 20

// Battery_Setup 2000 3100 1.68 2400 4096

// Safety timeout: maximaal 30 seconden wakker
addRepeatingEventID 30 1 1337 DeepSleep 900

// Wacht op WiFi
waitFor WiFiState 4

// Wacht op MQTT
waitFor MQTTState 1

// Verbinding gelukt: annuleer safety timeout
cancelRepeatingEvent 1337

// Publiceer temperatuur
publishChannel 1

// Slaap 15 minuten
DeepSleep 900
